# PostgreSQL local development
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/flowai
SPRING_DATASOURCE_USERNAME=flowai
SPRING_DATASOURCE_PASSWORD=flowai_dev_password

# PostgreSQL container password. docker-compose.yml refuses to start without it,
# and it must match SPRING_DATASOURCE_PASSWORD above.
POSTGRES_PASSWORD=flowai_dev_password

# The planning agent keeps its checkpoints in its own schema and connects as its
# own role, which cannot touch the application's tables. The postgres container
# creates both on a fresh volume; see agent/db/init-checkpoint-schema.sh.
AGENT_DB_PASSWORD=flowai_agent_dev_password
# The agent connects to that schema with this URL, so its password is the one
# above. Start the agent from agent/ with: uv run --env-file ../.env fastapi dev ...
CHECKPOINT_DATABASE_URL=postgresql://flowai_agent:flowai_agent_dev_password@localhost:5432/flowai
# Once the agent runs, turn it on for the backend so the UI offers it and runs reach
# it on port 8000. Without issue embeddings on the backend
# (SPRING_AI_MODEL_EMBEDDING=openai), also give the agent SEARCH_MODE=keyword.
# AGENT_ENABLED=true

# Redis local development
# Rate limits are counted here so every backend instance shares them. The
# development override publishes the Compose Redis on localhost; start it next to
# PostgreSQL. If it is not running, the backend counts in its own memory instead.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# JWT secrets and token TTLs
# Use at least 32 bytes for HS256.
JWT_SECRET=replace-this-with-a-local-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# The refresh cookie is Secure by default. Local Compose serves plain HTTP on
# :8080, where a Secure cookie is dropped, so turn it off for local runs only.
REFRESH_COOKIE_SECURE=false

# AI provider
# Required while the OpenAI Spring AI starter is enabled.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Demo dataset
# Writes one worked-in workspace on startup so a public deployment is not empty.
# Off by default; only a demo instance should turn it on. The seeder skips itself
# if the demo account already exists, so restarts never duplicate the data.
DEMO_SEED_ENABLED=false
DEMO_SEED_EMAIL=demo@flowai.dev
DEMO_SEED_PASSWORD=demo1234
DEMO_SEED_WORKSPACE_NAME=Northwind Labs

# A seeded Copilot draft expires after this, and an expired draft cannot be
# applied. Raise it on a long-lived demo so the Apply flow stays explorable.
# AI_SUGGESTION_TTL=3650d
